{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spank",
  "version": "0.1.0",
  "identifier": "com.chipcolate.spank.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spank",
        "width": 620,
        "height": 470,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "externalBin": [
      "binaries/spankd"
    ]
  }
}