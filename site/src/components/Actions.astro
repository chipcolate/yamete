---
import { getStrings, type Locale } from "../i18n";
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = getStrings(lang).actions;
---

<section id="actions">
  <div class="wrap">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2>{s.heading}</h2>
    <p class="lede">{s.lede}</p>

    <div class="recipes">
      <article class="recipe card">
        <h3>{s.soundTitle}</h3>
        <p>{s.soundBody}</p>
        <pre><code><span class="c"># out of the box</span>
/System/Library/
  Sounds/<span class="v">Sosumi.aiff</span></code></pre>
      </article>

      <article class="recipe card">
        <h3>{s.webhookTitle}</h3>
        <p>{s.webhookBody}</p>
        <pre><code><span class="c"># POST body</span>
&#123;
  "tier": "<span class="v">&#123;&#123;tier&#125;&#125;</span>",
  "g": <span class="v">&#123;&#123;peak_g&#125;&#125;</span>
&#125;</code></pre>
      </article>

      <article class="recipe card">
        <h3>{s.commandTitle}</h3>
        <p>{s.commandBody}</p>
        <pre><code><span class="c">$</span> osascript -e "set volume 0"
<span class="c">#</span> <span class="v">$YAMETE_TIER</span> → major
<span class="c">#</span> <span class="v">$YAMETE_PEAK_G</span> → 0.52</code></pre>
        <p class="mono meta">{s.advancedMeta}</p>
      </article>
    </div>

    <div class="pair">
      <div class="detail card card--quiet">
        <h3>{s.delayTitle}</h3>
        <p>{s.delayBody}</p>
      </div>
      <div class="detail card card--quiet">
        <h3>{s.severityTitle}</h3>
        <p>{s.severityBody}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .recipes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .recipe {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.6rem;
  }

  .recipe h3 {
    margin-bottom: 0.6rem;
  }

  .recipe p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* Pushes each card's snippet to the bottom so all three align regardless of how much
     prose sits above them. */
  .recipe pre {
    margin-top: auto;
  }

  .meta {
    margin: 0.75rem 0 0 !important;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  /* Quieter than the recipes — supporting detail, not a fourth option. */
  .card--quiet {
    background: rgb(255 255 255 / 0.4);
    box-shadow: none;
    border-style: dashed;
    border-width: 1.5px;
  }

  .detail {
    padding: 1.5rem 1.6rem;
  }

  .detail h3 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }

  .detail p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>
