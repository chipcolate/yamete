---
import data from "../data/traces.json";
import { type Trace, ACCEL_FULL_SCALE_G, GYRO_FULL_SCALE_DPS } from "../lib/chart";
import { getStrings, type Locale } from "../i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const s = getStrings(lang).discriminator;

const traces = data.traces as Trace[];
const order = ["desk-bump", "spank", "trackpad", "typing"];
const points = order.map((id) => {
  const t = traces.find((x) => x.id === id)!;
  const x = Math.min(t.peak_g / ACCEL_FULL_SCALE_G, 1) * 100;
  return {
    ...t,
    x,
    y: Math.min(t.gyro_peak / GYRO_FULL_SCALE_DPS, 1) * 100,
    side: x > 55 ? "left" : "right",
  };
});
---

<section id="how">
  <div class="wrap">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2>{s.heading}</h2>
    <p class="lede">{s.lede}</p>

    <div class="split">
      <figure class="plot card">
        <div class="plot__frame">
          <span class="mono ylab">{s.axisRotation}</span>
          <div class="field">
            {
              points.map((p) => (
                <span
                  class:list={["pt", p.verdict === "fires" && "pt--fires"]}
                  data-side={p.side}
                  style={`left:${p.x}%;bottom:${p.y}%`}
                >
                  <span class="dot" />
                  <span class="mono tag">{p.title}</span>
                </span>
              ))
            }
            <span class="mono corner corner--y">{GYRO_FULL_SCALE_DPS}</span>
            <span class="mono corner corner--x">{ACCEL_FULL_SCALE_G} g</span>
          </div>
          <span class="mono xlab">g</span>
        </div>
        <figcaption class="mono">{s.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 2.5rem;
  }

  .plot {
    margin: 0;
    padding: 1.25rem 1.35rem 1rem;
  }

  .plot__frame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
  }

  .field {
    position: relative;
    aspect-ratio: 1.25;
    border-left: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    /* A faint reference grid, so the positions read as measurements not decoration. */
    background-image:
      repeating-linear-gradient(to right, var(--hairline) 0 1px, transparent 1px 25%),
      repeating-linear-gradient(to top, var(--hairline) 0 1px, transparent 1px 25%);
  }

  .ylab,
  .xlab {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ylab {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    justify-self: center;
  }
  .xlab {
    grid-column: 2;
    text-align: center;
  }

  .corner {
    position: absolute;
    font-size: 0.55rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .corner--y {
    top: -0.3rem;
    left: -1.6rem;
  }
  .corner--x {
    right: 0;
    bottom: -1.15rem;
  }
  .corner--o {
    left: -0.7rem;
    bottom: -1.15rem;
  }

  /* Sized to the dot alone, so `translate` centres the marker on its data point rather
     than centring the marker-plus-label box and pushing the dot off the value. */
  .pt {
    position: absolute;
    width: 11px;
    height: 11px;
    translate: -50% 50%;
  }

  .dot {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--paper);
    border: 2px solid var(--muted);
    border-radius: 50%;
  }

  /* Blush is rotation throughout the page, and this is the one that has enough of it. */
  .pt--fires .dot {
    background: var(--blush);
    border-color: var(--ink);
    box-shadow: 0 0 0 5px rgb(255 148 138 / 0.28);
  }

  .tag {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    font-size: 0.6rem;
    white-space: nowrap;
    color: var(--muted);
  }
  .pt[data-side="right"] .tag {
    left: calc(100% + 0.45rem);
  }
  .pt[data-side="left"] .tag {
    right: calc(100% + 0.45rem);
  }

  .pt--fires .tag {
    font-weight: 600;
    color: var(--ink);
  }

  .cap {
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prose p {
    max-width: 46ch;
  }

  .aside {
    padding-left: 1rem;
    border-left: 2px solid var(--blush);
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
