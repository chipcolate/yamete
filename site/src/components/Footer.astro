---
import { REPO } from "../lib/site";
import {
  SITE_LOCALES,
  LOCALE_LABELS,
  DEFAULT_LOCALE,
  getStrings,
  localeUrl,
  type Locale,
} from "../i18n";

interface Props {
  lang: Locale;
  path?: string;
}
const { lang, path = "" } = Astro.props;
const s = getStrings(lang).footer;
---

<footer class="foot">
  <div class="wrap foot__grid">
    <p class="claim">{s.claim}</p>
    <nav class="links mono" aria-label="Elsewhere">
      <a href={REPO}>{s.github}</a>
      <a href={`${REPO}/releases`}>{s.releases}</a>
      <a href={localeUrl(lang, "privacy")}>{s.privacy}</a>
      <a href="https://chipcolate.com" rel="noopener noreferrer">{s.chipcolate}</a>
      <a href={`${REPO}/blob/main/README.md`}>{s.readme}</a>
      <label class="lang">
        <span class="sr-only">{s.languageLabel}</span>
        <select id="locale-switcher" data-path={path} data-default={DEFAULT_LOCALE}>
          {
            SITE_LOCALES.map((loc) => (
              <option value={loc} selected={loc === lang}>
                {LOCALE_LABELS[loc]}
              </option>
            ))
          }
        </select>
      </label>
    </nav>
    <p class="mono legal">{s.legal}</p>
  </div>
</footer>

<script>
  const select = document.getElementById("locale-switcher") as HTMLSelectElement | null;
  if (select) {
    const path = select.dataset.path ?? "";
    const def = select.dataset.default ?? "en";
    select.addEventListener("change", () => {
      const loc = select.value;
      const prefix = loc === def ? "" : `/${loc}`;
      const suffix = path ? `/${path.replace(/^\//, "")}` : "";
      window.location.href = `${prefix}${suffix}` || "/";
    });
  }
</script>

<style>
  .foot {
    padding-block: var(--rhythm) 3rem;
    border-top: 1.5px solid var(--ink);
  }

  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .claim {
    grid-row: 1;
    margin: 0;
    max-width: 52ch;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .links {
    grid-row: 1;
    display: flex;
    gap: 1.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legal {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.62rem;
    color: var(--muted);
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .foot__grid {
      grid-template-columns: 1fr;
    }
    .links {
      grid-row: auto;
    }
  }
</style>
