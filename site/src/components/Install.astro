---
import { CHECKSUMS, DOWNLOAD, REPO } from "../lib/site";
import { getStrings, type Locale } from "../i18n";
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = getStrings(lang).install;
---

<section id="install">
  <div class="wrap">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2>{s.heading}</h2>

    <div class="split">
      <div class="reqs">
        <dl class="req">
          <dt>{s.worksOn}</dt>
          <dd>{s.worksOnBody}</dd>

          <dt>{s.noSensor}</dt>
          <dd>{s.noSensorBody}</dd>

          <dt>{s.asksFor}</dt>
          <dd>{s.asksForBody}</dd>
        </dl>

        <div class="cta">
          <a class="btn" href={DOWNLOAD}>{s.download}</a>
          <a class="btn btn--ghost" href={CHECKSUMS}>{s.checksums}</a>
        </div>
        <p class="mono fine">{s.fine}</p>
      </div>

      <div class="cli">
        <h3>{s.daemonTitle}</h3>
        <p>{s.daemonBody}</p>
        <pre><code><span class="c"># probe</span>
yamete probe

<span class="c"># watch</span>
yamete watch --scores

<span class="c"># install</span>
yamete install --copy</code></pre>
        <p class="src">
          {s.src.split("github.com/chipcolate/yamete")[0]}
          <a href={REPO}>github.com/chipcolate/yamete</a>
          {s.src.split("github.com/chipcolate/yamete")[1] ?? ""}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(1.75rem, 4vw, 3.5rem);
    margin-top: 2.5rem;
    align-items: start;
  }

  .req {
    margin: 0 0 2rem;
  }

  .req dt {
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.9rem;
    border-top: 1.5px solid var(--ink);
  }

  .req dt:not(:first-child) {
    margin-top: 1.25rem;
  }

  .req dd {
    margin: 0.4rem 0 0;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fine {
    margin-top: 0.9rem;
    font-size: 0.62rem;
    color: var(--muted);
  }

  .cli h3 {
    margin-bottom: 0.6rem;
  }

  .cli p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .cli pre {
    margin: 1.25rem 0;
  }

  .src {
    font-size: 0.9rem;
  }
</style>
