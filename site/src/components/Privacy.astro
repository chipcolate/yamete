---
import { getStrings, localeUrl, type Locale } from "../i18n";
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = getStrings(lang).privacySection;
---

<section id="privacy" aria-labelledby="privacy-heading">
  <div class="wrap">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 id="privacy-heading">{s.heading}</h2>
    <p class="lede">{s.lede}</p>

    <ul class="points">
      <li class="point card">
        <p class="mono label">{s.localTitle}</p>
        <p>{s.localBody}</p>
      </li>
      <li class="point card">
        <p class="mono label">{s.accountTitle}</p>
        <p>{s.accountBody}</p>
      </li>
      <li class="point card">
        <p class="mono label">{s.actionsTitle}</p>
        <p>{s.actionsBody}</p>
      </li>
    </ul>

    <p class="more">
      <a href={localeUrl(lang, "privacy")}>{s.fullPolicy}</a>
      <span class="sep mono" aria-hidden="true">·</span>
      <a href={localeUrl(lang, "privacy") + "#questions"}>{s.questions}</a>
    </p>
  </div>
</section>

<style>
  .points {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.1rem;
  }

  .point {
    margin: 0;
    padding: 1.35rem 1.4rem 1.45rem;
  }

  .point p {
    margin: 0;
    max-width: none;
    font-size: 0.98rem;
    color: var(--muted);
  }

  .label {
    margin: 0 0 0.55rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .point code {
    font-size: 0.85em;
  }

  .more {
    margin: 1.75rem 0 0;
    font-size: 0.95rem;
  }

  .more a {
    font-weight: 500;
  }

  .sep {
    margin-inline: 0.65rem;
    color: var(--muted);
    opacity: 0.7;
  }
</style>
