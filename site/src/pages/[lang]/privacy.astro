---
import Base from "../../layouts/Base.astro";
import PrivacyPage from "../../components/PrivacyPage.astro";
import { SITE_LOCALES, DEFAULT_LOCALE, getStrings, isLocale, type Locale } from "../../i18n";

export function getStaticPaths() {
  return SITE_LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
if (!isLocale(raw)) throw new Error(`unknown locale ${raw}`);
const lang = raw as Locale;
const s = getStrings(lang);
---
<Base title={s.meta.privacyTitle} description={s.meta.privacyDescription} lang={lang}>
  <PrivacyPage lang={lang} />
</Base>
